[Icon Theme]
Name=Stealth Dark
Comment=Graphite folders and the Stealth Dark mark; everything else from Papirus-Dark or Breeze Dark
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
DisplayDepth=32
LinkOverlay=link
LockOverlay=lockoverlay
ZipOverlay=zip
DesktopDefault=48
DesktopSizes=16,22,32,48,64,128,256
ToolbarDefault=22
ToolbarSizes=16,22,32,48
MainToolbarDefault=22
MainToolbarSizes=16,22,32,48
SmallDefault=16
SmallSizes=16,22,32,48
PanelDefault=48
PanelSizes=16,22,32,48,64,128,256
DialogDefault=32
DialogSizes=16,22,32,48,64,128,256
FollowsColorScheme=true

Directories=scalable/places,symbolic/places

[scalable/places]
Size=64
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[symbolic/places]
Size=16
MinSize=8
MaxSize=512
Context=Places
Type=Scalable
